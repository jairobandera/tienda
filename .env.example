# ---------- Servidor ----------
NODE_ENV=development
PORT=3000
# URL pública de la tienda (en producción debe ser https://tudominio.com)
APP_URL=http://localhost:3000

# ---------- Base de datos (PostgreSQL) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tienda_kairos
# Poné true si tu proveedor de Postgres exige SSL (Render, Railway, Neon, etc.)
DB_SSL=false

# ---------- Seguridad ----------
# Cadena larga y aleatoria. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES=7d

# ---------- Mercado Pago ----------
# Credenciales en https://www.mercadopago.com.uy/developers/panel/app
# Si lo dejás vacío (solo en desarrollo) se activa un "pago simulado" para probar el flujo.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones > Webhooks > Clave secreta). Opcional pero recomendada.
MP_WEBHOOK_SECRET=

# ---------- Tienda ----------
WHATSAPP_NUMBER=59897961228
CURRENCY=UYU

# ---------- Administrador inicial (lo crea `npm run db:seed` o `npm run create-admin`) ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tiendakairos.com
ADMIN_PASSWORD=CambiarEstaClave123
