{
  "name": "tienda-kairos",
  "version": "1.0.0",
  "description": "Tienda Kairos - e-commerce con Node.js, PostgreSQL y Mercado Pago",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:setup": "node server/db/migrate.js && node server/db/seed.js",
    "create-admin": "node server/db/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.0.15",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
